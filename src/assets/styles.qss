/*
 * Application stylesheet. Loaded by ScratchApp at startup.
 * Qt stylesheets use CSS-like syntax. Layout margins and spacing live in Python.
 *
 * Starter palette (replace these values to customize the theme):
 *   Background: #20242b    File row: #292f38    Border: #3a414d
 *   Text:       #e5e7eb    Muted:    #8b95a5    Selection: #355b85
 */

/* Shared defaults */
QWidget {
    font-family: "Segoe UI";
    font-size: 10pt;
    color: #e5e7eb;
    background-color: #1c1c1c;
}

/* Browser panel: object names are assigned in file_browser.py. */
QWidget#fileBrowser {
    border: 1px solid #3a414d;
}

QLabel#fileBrowserTitle {
    font-size: 12pt;
    font-weight: bold;
    background-color: transparent;
}

QPushButton#fileBrowserSettingsButton {
    max-width: 24px;
    border: none;
}

QPushButton#fileBrowserSettingsButton:hover {

}

QWidget#settingsModal {
    background-color: #20242b;
    border: 1px solid #3a414d;
    border-radius: 6px;
}

QLabel#settingsModalTitle {
    color: #e5e7eb;
    background-color: transparent;
    font-size: 12pt;
    font-weight: bold;
    padding: 0 0 4px 0;
}

QCheckBox#settingsExtensionsCheck {
    color: #e5e7eb;
    background-color: #292f38;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 10px 8px;
    spacing: 10px;
}

QCheckBox#settingsExtensionsCheck:hover {
    background-color: #3a414d;
}

QCheckBox#settingsExtensionsCheck:focus {
    border-color: #8b95a5;
}

QCheckBox#settingsExtensionsCheck:pressed {
    background-color: #355b85;
}

QCheckBox#settingsExtensionsCheck:disabled {
    color: #8b95a5;
}

QWidget#fileList {
    background-color: transparent;
}

QWidget#fileEntry {
    background-color: #292f38;
    border: none;
    border-radius: 2px;
    padding: 4px;
}

QWidget#fileEntry:hover {
    background-color: #3a414d;
}

QLabel#fileEntryName,
QLabel#fileEntryIcon {
    background-color: transparent;
    border: none;
    padding: 0;
}

QLabel#fileBrowserEmpty {
    color: #8b95a5;
    background-color: transparent;
    padding: 12px 0;
}

QToolTip {
    color: #e5e7eb;
    background-color: #292f38;
    border: 1px solid #3a414d;
    padding: 6px 8px;
}

#fileBrowserScrollArea {
    border: none;
}

#fileBrowserScrollArea QScrollBar {
    background: #1c1c1c;
    border: none;
    margin: 0;
}

#fileBrowserScrollArea QScrollBar:vertical {
    width: 2px;
}

#fileBrowserScrollArea QScrollBar:horizontal {
    height: 10px;
}

#fileBrowserScrollArea QScrollBar::handle {
    background: #9b9b9b;
    border-radius: 99px;
}

#fileBrowserScrollArea QScrollBar::handle:vertical {
    min-height: 64px;
}

#fileBrowserScrollArea QScrollBar::handle:horizontal {
    min-width: 24px;
}

#fileBrowserScrollArea QScrollBar::handle:hover {
    background: #a9a9a9;
    width: 10px;
}

#fileBrowserScrollArea QScrollBar::handle:pressed {
    background: #355b85;
}

#fileBrowserScrollArea QScrollBar::add-line,
#fileBrowserScrollArea QScrollBar::sub-line {
    width: 0;
    height: 0;
    border: none;
    background: transparent;
}

#fileBrowserScrollArea QScrollBar::add-page,
#fileBrowserScrollArea QScrollBar::sub-page {
    background: transparent;
}

/* Tray context menu */
QMenu {
    border: 1px solid #3a414d;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
}

QMenu::item:selected {
    background-color: #355b85;
}

QMenu::item:disabled {
    color: #8b95a5;
}

QMenu::separator {
    height: 1px;
    background-color: #3a414d;
    margin: 4px 8px;
}
