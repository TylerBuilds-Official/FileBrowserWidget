/* Theme tokens are supplied by utils/system_theme.py. */
QWidget {
    font-family: "Segoe UI";
    font-size: 10pt;
    color: $text;
}
QWidget#fileBrowser, QWidget#settingsModal {
    background-color: $background;
    border: 1px solid $border;
}
QWidget#browserContent, QWidget#fileList, QWidget#settingsContent,
QScrollArea, QScrollArea > QWidget > QWidget {
    background: transparent;
    border: none;
}
QLabel { background: transparent; border: none; }
QLabel#fileBrowserTitle, QLabel#settingsModalTitle {
    font-size: 18pt;
    font-weight: 600;
}
QLabel[role="secondary"], QLabel#fileBrowserEmpty { color: $muted; }
QLabel[role="section"] { font-weight: 600; padding-top: 8px; }
QLabel[role="settingTitle"] { font-weight: 600; }
QWidget[role="settingCard"] {
    background-color: $surface;
    border: 1px solid $border;
    border-radius: 6px;
}
QPushButton {
    background: $surface;
    border: 1px solid $border;
    border-radius: 4px;
    padding: 6px 12px;
    min-height: 20px;
}
QPushButton:hover { background: $hover; }
QPushButton:pressed { background: $pressed; }
QPushButton:focus { border-color: $accent; }
QPushButton[role="iconButton"] {
    background: transparent;
    border: 1px solid transparent;
    padding: 0;
    min-height: 0;
}
QPushButton[role="iconButton"]:hover { background: $hover; }
QPushButton[role="iconButton"]:focus { border-color: $accent; }
QComboBox {
    background: $surface;
    border: 1px solid $border;
    border-bottom: 1px solid $muted;
    border-radius: 4px;
    padding: 7px 32px 7px 10px;
    min-height: 20px;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border: none;
    background: transparent;
}
QComboBox::down-arrow { image: url("$chevron"); width: 12px; height: 12px; }
QComboBox:hover { background: $hover; }
QComboBox:focus { border-bottom: 2px solid $accent; }
QComboBox QAbstractItemView {
    background: $surface;
    color: $text;
    border: 1px solid $border;
    padding: 4px;
    selection-background-color: $selection;
    selection-color: $text;
    outline: none;
}
QComboBox QAbstractItemView::item { min-height: 30px; padding: 2px 8px; }
QCheckBox { background: transparent; spacing: 10px; min-height: 28px; }
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid $muted;
    border-radius: 3px;
    background: $surface;
}
QCheckBox::indicator:hover { background: $hover; border-color: $accent; }
QCheckBox::indicator:checked {
    background: $accent;
    border-color: $accent;
    image: url("$checkmark");
}
QCheckBox:focus { color: $accent; }
QWidget#fileEntry {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
}
QWidget#fileEntry:hover { background: $hover; }
QWidget#fileEntry:focus { background: $selection; border-color: $accent; }
QLabel#fileEntryName, QLabel#fileEntryIcon { background: transparent; border: none; }
QLabel#fileBrowserEmpty { padding: 20px 0; }
QScrollBar:vertical { background: transparent; width: 8px; margin: 2px; }
QScrollBar::handle:vertical { background: $scrollbar; border-radius: 2px; min-height: 36px; }
QScrollBar::handle:vertical:hover { background: $muted; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QMenu { background: $surface; border: 1px solid $border; padding: 4px; }
QMenu::item { padding: 7px 28px 7px 12px; border-radius: 3px; }
QMenu::item:selected { background: $selection; }
QMenu::separator { height: 1px; background: $border; margin: 4px 8px; }
QToolTip { background: $surface; color: $text; border: 1px solid $border; padding: 6px; }

QLineEdit, QKeySequenceEdit {
    background: $surface;
    border: 1px solid $border;
    border-bottom: 1px solid $muted;
    border-radius: 4px;
    padding: 7px 10px;
    min-height: 20px;
}
QLineEdit:focus, QKeySequenceEdit:focus { border-bottom: 2px solid $accent; }
